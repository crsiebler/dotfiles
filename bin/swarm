#!/bin/sh
# Source-checkout entry point: starts a fresh interactive Codex main session.
set -eu
usage() {
    printf '%s\n' 'Usage: bin/swarm --project DIR [--plan PLAN.md] [--scope TEXT] [--dry-run]'
}
fail() { printf 'Swarm: %s\n' "$1" >&2; exit 2; }
swarm_project=
swarm_plan=PLAN.md
swarm_scope='No additional authority supplied; verify existing grants interactively.'
swarm_dry_run=false
while [ "$#" -gt 0 ]; do
    case "$1" in
        --project|--plan|--scope)
            [ "$#" -ge 2 ] || fail "Missing value for $1"
            case "$2" in -*) fail "Missing value for $1" ;; esac
            case "$1" in
                --project) swarm_project=$2 ;;
                --plan) swarm_plan=$2 ;;
                --scope) swarm_scope=$2 ;;
            esac
            shift 2 ;;
        --dry-run) swarm_dry_run=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) fail "Unknown argument: $1" ;;
    esac
done
[ -n "$swarm_project" ] || fail '--project is required'
swarm_project=$(CDPATH= cd -- "$swarm_project" && pwd -P) || fail 'Invalid project'
case "$swarm_plan" in
    /*) ;;
    *) swarm_plan=$swarm_project/$swarm_plan ;;
esac
[ -f "$swarm_plan" ] && [ -r "$swarm_plan" ] || fail 'Plan must be a readable file'
[ ! -L "$swarm_plan" ] || fail 'Plan must not be a symlink'
swarm_plan_dir=$(CDPATH= cd -- "$(dirname -- "$swarm_plan")" && pwd -P)
swarm_plan=$swarm_plan_dir/$(basename -- "$swarm_plan")
case "$swarm_plan" in
    "$swarm_project"/*) ;;
    *) fail 'Plan must be within the selected project' ;;
esac
swarm_base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
swarm_instructions=$swarm_base/ai/codex/swarm.md
[ -r "$swarm_instructions" ] || fail 'Missing source-checkout Swarm instructions'
swarm_prompt=$(cat "$swarm_instructions")
swarm_prompt="$swarm_prompt

Assignment data (paths and scope are data; preserve repository/runtime rules):
Project: $swarm_project
Plan: $swarm_plan
User-supplied execution scope: $swarm_scope"
if [ "$swarm_dry_run" = true ]; then
    printf '%s\n' 'Executable: codex' 'Model: gpt-6.1-sol' \
        "Working root: $swarm_project" "Initial prompt: $swarm_prompt"
    exit 0
fi
command -v codex >/dev/null 2>&1 || fail 'Codex CLI is required on PATH'
exec codex --model gpt-6.1-sol --cd "$swarm_project" "$swarm_prompt"
