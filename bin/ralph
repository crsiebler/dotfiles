#!/bin/bash

# Ralph CLI - Autonomous AI coding loop
# OpenCode-only runner.

set -euo pipefail

# Default values
MAX_ITERATIONS=10
RALPH_MODE="standard"
MODEL="openai/gpt-5.6-sol-fast"
MODEL_SOURCE="default"

valid_model() {
  case "$1" in
    opencode/big-pickle|\
    opencode/ling-3.0-flash-fin-free|\
    opencode/mimo-v2.5-free|\
    opencode/muse-spark-1.2-contributor-free|\
    opencode/nemotron-3-ultra-free|\
    opencode/nemotron-3.5-lightning-free|\
    mlx/mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit|\
    openai/gpt-5.3-codex-spark|\
    openai/gpt-5.4|\
    openai/gpt-5.4-fast|\
    openai/gpt-5.4-mini|\
    openai/gpt-5.4-mini-fast|\
    openai/gpt-5.5|\
    openai/gpt-5.5-fast|\
    openai/gpt-5.6-luna|\
    openai/gpt-5.6-luna-fast|\
    openai/gpt-5.6-sol|\
    openai/gpt-5.6-sol-fast|\
    openai/gpt-5.6-terra|\
    openai/gpt-5.6-terra-fast)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

usage() {
  printf '%s\n' "Usage: ralph [options]

Options:
  --max-iterations N   Maximum number of iterations to run (default: 10)
  --mode MODE          Execution mode: fast, standard, deep (default: standard)
  --model MODEL        OpenCode model (default: openai/gpt-5.6-sol-fast)
  -h, --help           Show this help message

Ralph is an autonomous AI coding agent that iteratively processes
user stories from plan.json until completion.

Requirements:
  - plan.json file in the current directory
  - OpenCode installed and configured (only for incomplete plans)
  - jq installed for plan.json parsing
  - Ralph agent at \$XDG_CONFIG_HOME/opencode/agents/ralph.md
    (default config root: ~/.config; nonempty override must be absolute)
  - Git worktree already on the exact plan branch, not main/master or detached"
}

error() {
  printf 'Error: %s\n' "$1" >&2
}

plan_complete() {
  jq -e 'all(.userStories[]; .passes == true)' plan.json >/dev/null
}

validate_plan() {
  if ! jq -es '
    def text: type == "string" and test("\\S");
    length == 1 and (.[0] |
      type == "object" and
      (.branchName | text) and
      (.userStories | type == "array" and length > 0) and
      all(.userStories[];
        type == "object" and
        (.id | text) and (.title | text) and (.description | text) and
        (.acceptanceCriteria | type == "array" and length > 0 and
          all(.[]; text)) and
        (.priority | type == "number" and . >= 0 and . == floor) and
        (.passes | type == "boolean")) and
      ([.userStories[].id] | length == (unique | length)))
  ' plan.json >/dev/null 2>&1; then
    error 'invalid plan.json: require one object with branchName and nonempty userStories; each story needs unique id, title, description, nonempty string acceptanceCriteria, nonnegative integer priority, and boolean passes'
    exit 1
  fi
}

require_value() {
  if [[ $# -lt 2 || -z "$2" || "$2" == --* || "$2" == -h ]]; then
    error "$1 requires a value"
    exit 1
  fi
}

check_branch() {
  local expected current
  if ! git rev-parse --is-inside-work-tree 2>/dev/null | \
    command grep -qx true; then
    error 'a prepared Git worktree is required'
    exit 1
  fi
  if ! current=$(git symbolic-ref --quiet HEAD); then
    error 'detached HEAD: prepare the plan branch before running Ralph'
    exit 1
  fi
  current=${current#refs/heads/}
  expected=$(jq -r '.branchName' plan.json)
  case "$current" in
    main|master)
      error 'protected branch: Ralph cannot run on main or master'
      exit 1
      ;;
  esac
  if ! git check-ref-format "refs/heads/$expected" >/dev/null 2>&1 || \
    ! jq -e --arg current "$current" '.branchName == $current' \
      plan.json >/dev/null; then
    error 'branch mismatch: prepare the exact plan.json branchName before running Ralph; no branches were switched'
    exit 1
  fi
  if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
    error 'a prepared Git worktree with an existing commit is required'
    exit 1
  fi
}

# Parse command line options
while [[ $# -gt 0 ]]; do
  case $1 in
    --max-iterations)
      require_value "$@"
      if [[ ! "$2" =~ ^[1-9][0-9]*$ || ${#2} -gt 9 ]]; then
        error "--max-iterations must be a positive integer (1-999999999)"
        exit 1
      fi
      MAX_ITERATIONS="$2"
      shift 2
      ;;
    --mode)
      require_value "$@"
      case "$2" in
        fast|standard|deep)
          RALPH_MODE="$2"
          ;;
        *)
          error "--mode must be one of: fast, standard, deep"
          exit 1
          ;;
      esac
      shift 2
      ;;
    --model)
      require_value "$@"
      if [[ "$2" == -* || "$2" == *[[:space:][:cntrl:]]* ]]; then
        error '--model must be a nonempty model identifier without whitespace'
        exit 1
      fi
      MODEL="$2"
      MODEL_SOURCE="explicit"
      shift 2
      ;;
    --auto|--auto=*)
      error '--auto has been removed; remove it from your invocation. Routine scoped work uses standing authorization, not harness permission bypasses; sensitive operations still require approval.'
      exit 1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      error "unknown option or argument: $1"
      printf "Use 'ralph --help' for usage information.\n" >&2
      exit 1
      ;;
  esac
done

if ! valid_model "$MODEL"; then
  error 'unsupported model for OpenCode; use an allowlisted provider/model identifier'
  printf "Use 'opencode models' to view available models.\n" >&2
  exit 1
fi

# Check if plan.json exists
if [[ ! -f "plan.json" ]]; then
  error "plan.json not found in current directory"
  printf 'Use the prepare-implementation skill to create plan.json from a PRD.\n' >&2
  exit 1
fi

# Check if jq is available for reliable plan.json completion checks
if ! command -v jq >/dev/null 2>&1; then
  error "jq command not found"
  printf 'Please install jq so Ralph can parse plan.json reliably.\n' >&2
  exit 1
fi

validate_plan
if plan_complete; then
  echo "All user stories completed."
  exit 0
fi

check_branch

if ! command -v opencode >/dev/null 2>&1; then
  error "opencode command not found"
  printf 'Please install OpenCode first: https://opencode.ai/install\n' >&2
  exit 1
fi

# Check the installer location, not OpenCode's effective merged agent selection.
if [[ -n "${XDG_CONFIG_HOME:-}" && "$XDG_CONFIG_HOME" != /* ]]; then
  error 'XDG_CONFIG_HOME must be an absolute path when set'
  exit 1
fi
RALPH_AGENT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/agents/ralph.md"
if [[ ! -f "$RALPH_AGENT_FILE" ]]; then
  error "$RALPH_AGENT_FILE not found"
  printf "With installation approval, run 'make install-opencode' from the dotfiles checkout.\n" >&2
  exit 1
fi

echo "Starting Ralph autonomous AI loop..."
printf 'Ralph agent file found: %s (OpenCode resolves the effective agent)\n' \
  "$RALPH_AGENT_FILE"
echo "Execution mode: $RALPH_MODE"
echo "Model: $MODEL"
echo "Model source: $MODEL_SOURCE"
echo ""

ITERATION=0
while [ $ITERATION -lt $MAX_ITERATIONS ]; do
  validate_plan
  check_branch
  echo "Iteration $((ITERATION + 1)) of $MAX_ITERATIONS"

  RALPH_RUNTIME_CONTEXT=$(cat <<EOF
Ralph runtime context:
- Harness: opencode
- Iteration: $((ITERATION + 1)) of $MAX_ITERATIONS
- Maximum iterations: $MAX_ITERATIONS
- Execution mode: $RALPH_MODE
- Model: $MODEL
- Model source: $MODEL_SOURCE

Treat these values as authoritative for this invocation. Follow your Ralph
agent instructions, work on exactly one incomplete story, and let the runner
enforce the iteration limit and completion checks.
EOF
)

  # Select the native primary agent; the runner remains the hard-limit boundary.
  if opencode run --agent ralph -m "$MODEL" --variant high \
    "$RALPH_RUNTIME_CONTEXT"; then
    :
  else
    result=$?
    error "OpenCode failed (exit $result); stopping without another iteration"
    exit "$result"
  fi

  ITERATION=$((ITERATION + 1))

  # Validate mutations and branch even when the harness claims completion.
  validate_plan
  check_branch
  if plan_complete; then
    echo "All user stories completed."
    exit 0
  fi
done

echo "Reached maximum iterations ($MAX_ITERATIONS) without completing all stories."
exit 1
