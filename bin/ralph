#!/bin/bash

# Ralph CLI - Autonomous AI coding loop
# Runs OpenCode with the Ralph primary agent for autonomous implementation

set -e

# Default values
MAX_ITERATIONS=10
RALPH_MODE="standard"
RALPH_AUTO_APPROVAL="disabled"
MODEL="openai/gpt-5.6-sol-fast"

valid_model() {
  case "$1" in
    opencode/big-pickle|\
    opencode/ling-3.0-flash-fin-free|\
    opencode/mimo-v2.5-free|\
    opencode/muse-spark-1.2-contributor-free|\
    opencode/nemotron-3-ultra-free|\
    opencode/nemotron-3.5-lightning-free|\
    mlx/mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit|\
    openai/gpt-5.3-codex-spark|\
    openai/gpt-5.4|\
    openai/gpt-5.4-fast|\
    openai/gpt-5.4-mini|\
    openai/gpt-5.4-mini-fast|\
    openai/gpt-5.5|\
    openai/gpt-5.5-fast|\
    openai/gpt-5.6-luna|\
    openai/gpt-5.6-luna-fast|\
    openai/gpt-5.6-sol|\
    openai/gpt-5.6-sol-fast|\
    openai/gpt-5.6-terra|\
    openai/gpt-5.6-terra-fast)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

usage() {
  cat <<EOF
Usage: ralph [options]

Options:
  --max-iterations N   Maximum number of iterations to run (default: 10)
  --mode MODE          Execution mode: fast, standard, deep (default: standard)
  --model MODEL        Model to use (default: openai/gpt-5.6-sol-fast)
  --auto               Enable automatic approval for OpenCode operations
  -h, --help           Show this help message

Ralph is an autonomous AI coding agent that iteratively processes
user stories from prd.json until completion.

Requirements:
  - prd.json file in the current directory
  - OpenCode installed and configured
  - jq installed for prd.json parsing
  - Ralph agent installed at ~/.config/opencode/agents/ralph.md
  - Git repository with proper setup
EOF
}

error() {
  printf 'Error: %s\n' "$1" >&2
}

prd_complete() {
  jq -e '(.userStories | type == "array") and all(.userStories[]; .passes == true)' prd.json >/dev/null
}

# Parse command line options
while [[ $# -gt 0 ]]; do
  case $1 in
    --max-iterations)
      if [[ -z "$2" ]]; then
        error "--max-iterations requires a value"
        printf "Use 'ralph --help' for usage information.\n" >&2
        exit 1
      fi
      if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
        error "--max-iterations must be a positive integer"
        exit 1
      fi
      MAX_ITERATIONS="$2"
      shift 2
      ;;
    --mode)
      if [[ -z "$2" ]]; then
        error "--mode requires a value"
        printf "Use 'ralph --help' for usage information.\n" >&2
        exit 1
      fi
      case "$2" in
        fast|standard|deep)
          RALPH_MODE="$2"
          ;;
        *)
          error "--mode must be one of: fast, standard, deep"
          exit 1
          ;;
      esac
      shift 2
      ;;
    --model)
      if [[ -z "$2" ]]; then
        error "--model requires a value"
        printf "Use 'ralph --help' for usage information.\n" >&2
        exit 1
      fi
      if ! valid_model "$2"; then
        error "unsupported model: $2"
        printf "Use 'opencode models' to view available models.\n" >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    --auto)
      RALPH_AUTO_APPROVAL="enabled"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      error "unknown option or argument: $1"
      printf "Use 'ralph --help' for usage information.\n" >&2
      exit 1
      ;;
  esac
done

# Check if prd.json exists
if [[ ! -f "prd.json" ]]; then
  error "prd.json not found in current directory"
  printf 'Use the /ralph command in OpenCode to create prd.json from a PRD.\n' >&2
  exit 1
fi

# Check if opencode is available
if ! command -v opencode >/dev/null 2>&1; then
  error "opencode command not found"
  printf 'Please install OpenCode first: https://opencode.ai/install\n' >&2
  exit 1
fi

# Check if jq is available for reliable prd.json completion checks
if ! command -v jq >/dev/null 2>&1; then
  error "jq command not found"
  printf 'Please install jq so Ralph can parse prd.json reliably.\n' >&2
  exit 1
fi

export RALPH_MODE="$RALPH_MODE"
export RALPH_AUTO_APPROVAL

OPENCODE_ARGS=()
if [[ "$RALPH_AUTO_APPROVAL" == "enabled" ]]; then
  OPENCODE_ARGS+=(--auto)
fi

# Check if the Ralph agent exists in the installed location
RALPH_AGENT_FILE="$HOME/.config/opencode/agents/ralph.md"
if [[ ! -f "$RALPH_AGENT_FILE" ]]; then
  error "$RALPH_AGENT_FILE not found"
  printf "Please run 'make install' to set up the Ralph configuration.\n" >&2
  exit 1
fi

echo "Starting Ralph autonomous AI loop..."
echo "Using Ralph agent from $RALPH_AGENT_FILE"
echo "Execution mode: $RALPH_MODE"
echo "Model: $MODEL"
echo "Auto approval: $RALPH_AUTO_APPROVAL"
echo ""

if prd_complete; then
  echo "All user stories completed."
  exit 0
fi

ITERATION=0
while [ $ITERATION -lt $MAX_ITERATIONS ]; do
  echo "Iteration $((ITERATION + 1)) of $MAX_ITERATIONS"

  RALPH_RUNTIME_CONTEXT=$(cat <<EOF
Ralph runtime context:
- Iteration: $((ITERATION + 1)) of $MAX_ITERATIONS
- Maximum iterations: $MAX_ITERATIONS
- Execution mode: $RALPH_MODE
- Auto approval: $RALPH_AUTO_APPROVAL

Treat these values as authoritative for this invocation. Follow your Ralph
agent instructions, work on exactly one incomplete story, and let the runner
enforce the iteration limit and completion checks.
EOF
)

  # Select the native primary agent; the runner remains the hard-limit boundary.
  opencode run --agent ralph "${OPENCODE_ARGS[@]}" -m "$MODEL" --variant high \
    "$RALPH_RUNTIME_CONTEXT"

  ITERATION=$((ITERATION + 1))

  # Check if all user stories pass
  if prd_complete; then
    echo "All user stories completed."
    exit 0
  fi
done

echo "Reached maximum iterations ($MAX_ITERATIONS) without completing all stories."
exit 1
