mkcd() {
  if (( $# != 1 )); then
    print -u2 "Usage: mkcd <directory>"
    return 2
  fi

  mkdir -p -- "$1" && cd -- "$1"
}

# Serve the local Bonsai model using the isolated uv-tool installation.
mlx-bonsai() {
  mlx_vlm.server \
    --model "$HOME/Models/bonsai-2-mlx" \
    --host 127.0.0.1 --port 8081 \
    --max-num-seqs 1 \
    --prefill-step-size 512 \
    --max-kv-size 65536 \
    --max-tokens 8192 \
    --enable-thinking \
    --thinking-budget 4096 \
    "$@"
}

alias hs='history | grep'

myip() {
  curl -fsS https://api.ipify.org && printf '\n'
}

alias svim='sudo vim'
