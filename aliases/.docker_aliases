# Docker aliases (shortcuts)
dkclean() {
  local output
  local -a containers

  output="$(docker ps --all --quiet --filter status=exited)" || return
  [[ -n $output ]] || return 0
  containers=("${(@f)output}")
  docker rm -- "${containers[@]}"
}

dke() {
  if (( $# != 1 )); then
    print -u2 "Usage: dke <container>"
    return 2
  fi

  docker exec -it "$1" /bin/sh
}

dkexe() {
  if (( $# < 2 )); then
    print -u2 "Usage: dkexe <container> <command> [args...]"
    return 2
  fi

  local container="$1"
  shift
  docker exec "$container" "$@"
}

dkln() {
  if (( $# != 1 )); then
    print -u2 "Usage: dkln <container>"
    return 2
  fi

  docker logs -f "$1"
}

dkprune() {
  local reply

  read -r "reply?Delete all unused Docker data? [y/N] " || return 1
  print
  [[ $reply == [yY] ]] && docker system prune -af
}

dkrun() {
  if (( $# == 0 )); then
    print -u2 "Usage: dkrun <image> [args...]"
    return 2
  fi

  docker run -it "$@"
}

dkstats() {
  if (( $# == 0 )); then
    docker stats --no-stream
  else
    docker stats --no-stream "$@"
  fi
}

dktop() {
  docker stats --format "table {{.Container}}\t{{.Name}}\t{{.CPUPerc}}  {{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}"
}

alias dk='docker'
alias dki='docker images'
alias dkif='docker image ls --format "table {{.Repository}}\t{{.Tag}}\t{{.ID}}"'
alias dkis='docker image ls --format "table {{.Repository}}\t{{.Tag}}\t{{.ID}}" | grep -v REPOSITORY | sort'
alias dkl='docker logs'
alias dklf='docker logs -f'
alias dkstrt='docker start'
alias dkps="docker ps --format '{{.ID}} ~ {{.Names}} ~ {{.Status}} ~ {{.Image}}'"
alias dkpsa='docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"'
alias dkpsas='docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}" | grep -v NAMES | sort'
alias dkrm='docker rm'
alias dkrmi='docker rmi'
alias dks='docker service'
alias dkstp='docker stop'
alias dkstpall='docker stop $(docker ps -a -q)'
alias dkv='docker volume'
alias dkvls='docker volume ls'
if (( $+commands[docker-machine] )); then
  alias dm='docker-machine'
  alias dmx='docker-machine ssh'
fi
