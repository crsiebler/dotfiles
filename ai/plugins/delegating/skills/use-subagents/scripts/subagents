#!/bin/sh
set -eu
script=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for python in "${PYTHON:-python3.11}" python3 python3.12 python3.13 python3.14; do
    if command -v "$python" >/dev/null 2>&1 && "$python" -c 'import tomllib' 2>/dev/null; then
        exec "$python" "$script/subagents.py" "$@"
    fi
done
printf '%s\n' 'subagents: Python 3.11+ is required; set PYTHON to its executable.' >&2
exit 1
