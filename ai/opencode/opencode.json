{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "mcp": {
        "chrome": {
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "enabled": true,
            "type": "local"
        },
        "context7": {
            "enabled": true,
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            },
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "jam": {
            "enabled": true,
            "type": "remote",
            "url": "https://mcp.jam.dev/mcp"
        },
        "playwright": {
            "command": [
                "npx",
                "@playwright/mcp@latest"
            ],
            "enabled": true,
            "type": "local"
        }
    },
    "permission": {
        "skill": {
            "code-review-analyzer": "allow",
            "code-review-resolver": "allow"
        }
    },
    "plugin": [
        "@mohak34/opencode-notifier@0.1.15"
    ],
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama",
            "options": {
                "baseURL": "http://localhost:11434/v1",
                "apiKey": "ollama"
            },
            "models": {
                "qwen3-coder-49k": {
                    "name": "Qwen3 Coder",
                    "limit": {
                        "context": 49152,
                        "output": 8192
                    }
                }
            }
        }
    }
}