{
    "$schema": "https://opencode.ai/config.json",
    "agents": {
        "title": {
            "model": "openai/gpt-6-luna"
        }
    },
    "commands": {
        "create-audio": {
            "description": "Generate audio through the create-audio skill",
            "template": "Load the installed create-audio skill. Use the active project's instructions, prompts, and request JSON to select a supported audio model and its settings. Resolve bundled scripts from the installed skill. Follow project batch authorization and review requirements. Request: $ARGUMENTS"
        }
    },
    "mcp": {
        "servers": {
            "chrome": {
                "command": [
                    "npx",
                    "-y",
                    "chrome-devtools-mcp@latest"
                ],
                "disabled": true,
                "type": "local"
            },
            "context7": {
                "disabled": false,
                "headers": {
                    "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
                },
                "type": "remote",
                "url": "https://mcp.context7.com/mcp"
            },
            "docker": {
                "command": [
                    "docker",
                    "mcp",
                    "gateway",
                    "run"
                ],
                "disabled": true,
                "type": "local"
            },
            "elevenlabs": {
                "command": [
                    "uvx",
                    "elevenlabs-mcp"
                ],
                "disabled": true,
                "environment": {
                    "ELEVENLABS_API_KEY": "{env:ELEVENLABS_API_KEY}",
                    "ELEVENLABS_MCP_OUTPUT_MODE": "files"
                },
                "type": "local"
            },
            "exa": {
                "disabled": false,
                "headers": {
                    "x-api-key": "{env:EXA_API_KEY}"
                },
                "type": "remote",
                "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,agent_run,web_search_advanced_exa"
            },
            "github": {
                "disabled": false,
                "headers": {
                    "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}",
                    "X-MCP-Toolsets": "repos,issues,pull_requests"
                },
                "oauth": false,
                "type": "remote",
                "url": "https://api.githubcopilot.com/mcp/"
            },
            "jam": {
                "disabled": true,
                "type": "remote",
                "url": "https://mcp.jam.dev/mcp"
            },
            "jev": {
                "command": [
                    "node",
                    "{env:HOME}/Repositories/mcp-suite/servers/jev/dist/servers/jev/src/index.js"
                ],
                "disabled": true,
                "environment": {
                    "AI_GATEWAY_API_KEY": "{env:AI_GATEWAY_API_KEY}",
                    "JEV_TIMEOUT_MS": "30000"
                },
                "timeout": {
                    "catalog": 60000,
                    "execution": 60000
                },
                "type": "local"
            },
            "jira": {
                "disabled": true,
                "type": "remote",
                "url": "https://mcp.atlassian.com/v2/mcp"
            },
            "playwright": {
                "command": [
                    "npx",
                    "@playwright/mcp@latest"
                ],
                "disabled": true,
                "type": "local"
            },
            "postgresql": {
                "command": [
                    "node",
                    "{env:HOME}/Repositories/mcp-suite/servers/postgresql/dist/servers/postgresql/src/index.js"
                ],
                "disabled": true,
                "environment": {
                    "POSTGRESQL_CONNECTION_STRING": "{env:POSTGRESQL_CONNECTION_STRING}"
                },
                "type": "local"
            },
            "vercel": {
                "disabled": true,
                "type": "remote",
                "url": "https://mcp.vercel.com"
            }
        }
    },
    "model": "openai/gpt-6-astra",
    "permissions": [
