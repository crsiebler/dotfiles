{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "mcp": {
        "chrome": {
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "enabled": false,
            "type": "local"
        },
        "context7": {
            "enabled": true,
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            },
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "elevenlabs": {
            "command": [
                "uvx",
                "elevenlabs-mcp"
            ],
            "enabled": false,
            "environment": {
                "ELEVENLABS_API_KEY": "{env:ELEVENLABS_API_KEY}",
                "ELEVENLABS_MCP_OUTPUT_MODE": "files"
            },
            "type": "local"
        },
        "jam": {
            "enabled": false,
            "type": "remote",
            "url": "https://mcp.jam.dev/mcp"
        },
        "jira": {
            "command": [
                "node",
                "{env:HOME}/Repositories/mcp-suite/servers/jira/dist/servers/jira/src/index.js"
            ],
            "enabled": false,
            "environment": {
                "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
                "JIRA_BASE_URL": "{env:JIRA_BASE_URL}",
                "JIRA_EMAIL": "{env:JIRA_EMAIL}"
            },
            "type": "local"
        },
        "playwright": {
            "command": [
                "npx",
                "@playwright/mcp@latest"
            ],
            "enabled": false,
            "type": "local"
        },
        "postgresql": {
            "command": [
                "node",
                "{env:HOME}/Repositories/mcp-suite/servers/postgresql/dist/servers/postgresql/src/index.js"
            ],
            "enabled": false,
            "environment": {
                "POSTGRESQL_CONNECTION_STRING": "{env:POSTGRESQL_CONNECTION_STRING}"
            },
            "type": "local"
        }
    },
    "permission": {
        "skill": {
            "code-review-analyzer": "allow",
            "code-review-resolver": "allow"
        }
    },
    "plugin": [
        "@mohak34/opencode-notifier@0.1.15",
        "opencode-dir",
        "opencode-gpt-imagegen@0.1.9"
    ],
    "provider": {
        "mlx": {
            "models": {
                "mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit": {
                    "limit": {
                        "context": 65536,
                        "output": 8192
                    },
                    "modalities": {
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "name": "Qwen3 Coder 30B A3B MLX",
                    "reasoning": false,
                    "temperature": true,
                    "tool_call": true
                }
            },
            "name": "MLX Local",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "apiKey": "none",
                "baseURL": "http://127.0.0.1:8080/v1",
                "chunkTimeout": 120000,
                "headerTimeout": 600000,
                "timeout": false
            }
        }
    }
}