{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "mcp": {
        "chrome": {
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "enabled": false,
            "type": "local"
        },
        "context7": {
            "enabled": true,
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            },
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "elevenlabs": {
            "command": [
                "uvx",
                "elevenlabs-mcp"
            ],
            "enabled": false,
            "environment": {
                "ELEVENLABS_API_KEY": "{env:ELEVENLABS_API_KEY}",
                "ELEVENLABS_MCP_OUTPUT_MODE": "files"
            },
            "type": "local"
        },
        "exa": {
            "enabled": true,
            "headers": {
                "x-api-key": "{env:EXA_API_KEY}"
            },
            "type": "remote",
            "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,agent_run,web_search_advanced_exa"
        },
        "github": {
            "enabled": true,
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "oauth": false,
            "headers": {
                "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}",
                "X-MCP-Toolsets": "repos,issues,pull_requests"
            }
        },
        "jam": {
            "enabled": false,
            "type": "remote",
            "url": "https://mcp.jam.dev/mcp"
        },
        "jira": {
            "enabled": false,
            "type": "remote",
            "url": "https://mcp.atlassian.com/v2/mcp"
        },
        "playwright": {
            "command": [
                "npx",
                "@playwright/mcp@latest"
            ],
            "enabled": false,
            "type": "local"
        },
        "postgresql": {
            "command": [
                "node",
                "{env:HOME}/Repositories/mcp-suite/servers/postgresql/dist/servers/postgresql/src/index.js"
            ],
            "enabled": false,
            "type": "local",
            "environment": {
                "POSTGRESQL_CONNECTION_STRING": "{env:POSTGRESQL_CONNECTION_STRING}"
            }
        }
    },
    "permission": {
        "github_*": "ask",
        "github_get_commit": "allow",
        "github_get_file_contents": "allow",
        "github_get_label": "allow",
        "github_get_latest_release": "allow",
        "github_get_release_by_tag": "allow",
        "github_get_tag": "allow",
        "github_issue_read": "allow",
        "github_list_branches": "allow",
        "github_list_commits": "allow",
        "github_list_issue_fields": "allow",
        "github_list_issue_types": "allow",
        "github_list_issues": "allow",
        "github_list_pull_requests": "allow",
        "github_list_releases": "allow",
        "github_list_repository_collaborators": "allow",
        "github_list_tags": "allow",
        "github_pull_request_read": "allow",
        "github_search_code": "allow",
        "github_search_commits": "allow",
        "github_search_issues": "allow",
        "github_search_pull_requests": "allow",
        "github_search_repositories": "allow",
        "jira_*": "ask",
        "jira_atlassianUserInfo": "allow",
        "jira_getAccessibleAtlassianResources": "allow",
        "jira_discover": "allow",
        "jira_getContentFormatGuide": "allow",
        "jira_executeRead": "allow",
        "jira_search": "allow",
        "jira_getTeamworkGraphContext": "allow",
        "jira_getTeamworkGraphObject": "allow",
        "jira_getJiraIssue": "allow",
        "jira_listJiraProjects": "allow",
        "jira_listJiraProjectIssueTypesMetadata": "allow",
        "jira_getJiraIssueTypeMetaWithFields": "allow",
        "jira_listJiraIssueTransitions": "allow",
        "jira_listJiraIssueLinkTypes": "allow",
        "jira_listJiraIssueRemoteIssueLinks": "allow",
        "jira_listJiraIssueWorklogs": "allow",
        "jira_lookupJiraAccountId": "allow",
        "jira_findJiraIssueAssignableUsers": "allow",
        "jira_listJiraIssueComments": "allow",
        "jira_listJiraIssueChangelogs": "allow",
        "jira_getJiraCurrentUser": "allow",
        "jira_getJiraUser": "allow",
        "jira_listJiraStatuses": "allow",
        "jira_listJiraProjectComponents": "allow",
        "jira_getJiraProjectVersions": "allow",
        "jira_getJiraProjectVersionRelatedWork": "allow",
        "jira_listJiraBoards": "allow",
        "jira_getJiraBoardConfig": "allow",
        "jira_getJiraBoardIssueData": "allow",
        "jira_getJiraBoardSprintData": "allow",
        "jira_listJiraBoardSprints": "allow",
        "jira_listJiraFilters": "allow",
        "jira_listJiraDashboards": "allow",
        "jira_getJiraEntityProperty": "allow",
        "jira_downloadJiraIssueAttachment": "allow",
        "jira_searchJiraIssuesUsingJql": "allow",
        "jira_getJiraIssueRemoteIssueLinks": "allow",
        "jira_getJiraProjectIssueTypesMetadata": "allow",
        "jira_getIssueLinkTypes": "allow",
        "jira_getTransitionsForJiraIssue": "allow",
        "jira_getVisibleJiraProjects": "allow",
        "jira_getConfluencePage": "allow",
        "jira_getConfluencePageDescendants": "allow",
        "jira_getConfluencePageFooterComments": "allow",
        "jira_getConfluencePageInlineComments": "allow",
        "jira_getConfluenceCommentChildren": "allow",
        "jira_getConfluenceSpaces": "allow",
        "jira_getPagesInConfluenceSpace": "allow",
        "jira_searchConfluenceUsingCql": "allow",
        "jira_searchAtlassian": "allow",
        "jira_fetchAtlassian": "allow",
        "jira_fetch": "allow",
        "postgresql_*": "ask",
        "postgresql_check_dangerous_operations_allowed": "allow",
        "exa_*": "deny",
        "exa_web_search_exa": "allow",
        "exa_web_search_advanced_exa": "allow",
        "exa_web_fetch_exa": "allow",
        "exa_agent_run": "allow",
        "context7_*": "deny",
        "context7_resolve-library-id": "allow",
        "context7_query-docs": "allow",
        "chrome_*": "allow",
        "playwright_*": "allow",
        "jam_*": "allow",
        "elevenlabs_*": "ask",
        "skill": {
            "analyze-review-feedback": "allow",
            "resolve-review-feedback": "allow"
        }
    },
    "plugin": [
        "@mohak34/opencode-notifier@0.1.15",
        "opencode-dir@1.2.3",
        "opencode-gpt-imagegen@0.1.9"
    ],
    "provider": {
        "mlx": {
            "models": {
                "mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit": {
                    "limit": {
                        "context": 65536,
                        "output": 8192
                    },
                    "modalities": {
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "name": "Qwen3 Coder 30B A3B MLX",
                    "reasoning": false,
                    "temperature": true,
                    "tool_call": true
                }
            },
            "name": "MLX Local",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "apiKey": "none",
                "baseURL": "http://127.0.0.1:8080/v1",
                "chunkTimeout": 120000,
                "headerTimeout": 600000,
                "timeout": false
            }
        }
    }
}
