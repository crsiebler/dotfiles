    "plugins": [],
    "providers": {
        "bonsai": {
            "models": {
                "prism-ml/Ternary-Bonsai-2-27B-mlx-2bit": {
                    "capabilities": {
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ],
                        "tools": true
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "limit": {
                        "context": 65536,
                        "output": 8192
                    },
                    "name": "Ternary Bonsai 2 27B MLX 2-bit"
                }
            },
            "name": "Bonsai 2 MLX Local",
            "package": "aisdk:@ai-sdk/openai-compatible",
            "settings": {
                "apiKey": "none",
                "baseURL": "http://127.0.0.1:8081/v1",
                "chunkTimeout": 120000,
                "headerTimeout": 600000,
                "timeout": false
            }
        }
    }
